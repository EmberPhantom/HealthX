# Server
NODE_ENV=production
PORT=3000
LOG_LEVEL=warn

# Database — use Atlas or managed MongoDB, NOT localhost
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/healthx?retryWrites=true&w=majority

# Redis — use managed Redis (Upstash, ElastiCache, etc.)
REDIS_URL=rediss://<user>:<password>@<host>:6380
REDIS_PASSWORD=<strong-random-password>

# JWT — MUST be 64+ character random hex strings
JWT_SECRET=<64-char-hex>
JWT_REFRESH_SECRET=<different-64-char-hex>
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Google OAuth
GOOGLE_CLIENT_ID=<your-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-client-secret>
GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/v1/auth/google/callback

# AWS S3 (for file uploads in production)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=<iam-access-key>
AWS_SECRET_ACCESS_KEY=<iam-secret-key>
AWS_S3_BUCKET=healthx-prod-files

# Email (use SendGrid in production, not Gmail SMTP)
SENDGRID_API_KEY=SG.<your-sendgrid-key>
EMAIL_FROM=noreply@yourdomain.com

# Frontend
FRONTEND_URL=https://app.yourdomain.com

# Error Tracking
SENTRY_DSN=https://<key>@<id>.ingest.sentry.io/<project>

# IP Security
IP_WHITELIST=
