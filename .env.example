# Server Configuration
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/healthx
MONGO_DB_NAME=healthx

# Cache & Queue
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# JWT (Run 'npx tsx src/scripts/generate-secrets.ts' to generate cryptographically secure production keys)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_EXPIRY=30m
JWT_REFRESH_EXPIRY=30d

# Google OAuth
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_S3_BUCKET=healthx-files

# Razorpay
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx
RAZORPAY_WEBHOOK_SECRET=xxx

# Firebase (Firebase Admin SDK for server-side FCM push notifications)
# Get these from Firebase Console → Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com

# SendGrid
SENDGRID_API_KEY=SG.xxx

# Twilio
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_PHONE_NUMBER=+1234567890

# Sentry
SENTRY_DSN=https://xxx@xxx.ingest.sentry.io/xxx

# Gemini AI
GEMINI_API_KEY=xxx

# Groq AI (Fallback for AI health analysis)
GROQ_API_KEY=gsk_xxx
GROQ_MODEL=llama3-70b-8192

# AI Health Personalization Layer
AI_ANALYSIS_MAX_RETRIES=3
AI_REANALYSIS_TRIGGER_THRESHOLD=5

# Frontend URL
FRONTEND_URL=http://localhost:8080

# API Documentation
API_VERSION=v1
API_TITLE=HealthX API
API_DESCRIPTION=Enterprise Health & Fitness Platform API
